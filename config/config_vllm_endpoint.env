#!/usr/bin/env bash
# Shared client configuration for an already-running vLLM endpoint.
#
# Usage:
#   export VLLM_URL=http://hpc-node:8000
#   export VLLM_SERVED_MODEL=Qwen3.6-27B
#   source config/config_vllm_endpoint.env

if [ -z "${VLLM_URL:-}" ]; then
    echo "Error: VLLM_URL is required." >&2
    return 1 2>/dev/null || exit 1
fi
if [ -z "${VLLM_SERVED_MODEL:-}" ]; then
    echo "Error: VLLM_SERVED_MODEL is required." >&2
    return 1 2>/dev/null || exit 1
fi

VLLM_OPENAI_BASE="${VLLM_URL%/}"
case "$VLLM_OPENAI_BASE" in
    */v1) ;;
    *) VLLM_OPENAI_BASE="$VLLM_OPENAI_BASE/v1" ;;
esac

export OPENAI_BASE_URL="$VLLM_OPENAI_BASE"
export OPENAI_API_BASE="$VLLM_OPENAI_BASE"

# The OpenAI SDK and LiteLLM require a nonempty client key even when vLLM was
# launched without authentication. Override VLLM_API_KEY when auth is enabled.
export OPENAI_API_KEY="${VLLM_API_KEY:-local-vllm}"
export OPENAI_API_KEY_1="$OPENAI_API_KEY"

export GENOMAS_MODEL="$VLLM_SERVED_MODEL"
export GENOMAS_VENDOR="vLLM"

# LiteLLM uses the prefix to select its OpenAI-compatible adapter. The request
# sent to vLLM carries the served model name without this prefix.
export SCILINK_MODEL="openai/$VLLM_SERVED_MODEL"
export SCILINK_VENDOR="vLLM"
