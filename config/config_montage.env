# Config for the fixed-input Montage traditional-workflow trace on CloudLab.

# --- Lustre paths -----------------------------------------------------------
RESULTS_OWNER="${RESULTS_OWNER:-${SUDO_USER:-${SSH_USER:-${USER:-Minqiu}}}}"
RESULTS_ROOT="${RESULTS_ROOT:-${MOUNT_PATH:-/mnt/lustrefs}/$RESULTS_OWNER/pi-ebpf-tracing-handoff/results}"
BASE_OUT="${BASE_OUT:-$RESULTS_ROOT/classic_montage_$(date +%Y%m%d_%H%M%S)}"
MONTAGE_ROOT="${MONTAGE_ROOT:-${MOUNT_PATH:-/mnt/lustrefs}/$RESULTS_OWNER/montage}"
MONTAGE_INPUT_ROOT="${MONTAGE_INPUT_ROOT:-$MONTAGE_ROOT/input}"

# The trace runtime must support this repository's Python syntax and MontagePy.
# Overview.md creates this separate environment on Lustre.
MONTAGE_PYTHON="${MONTAGE_PYTHON:-$MONTAGE_ROOT/trace-venv/bin/python}"
AGENT_PYTHON="${AGENT_PYTHON:-$MONTAGE_PYTHON}"
POST_PYTHON="${POST_PYTHON:-$MONTAGE_PYTHON}"
TRACER_PYTHON="${TRACER_PYTHON:-/usr/bin/python3}"
WORKFLOW_CMD="${WORKFLOW_CMD:-$AGENT_PYTHON -m agent_io_tracing.adapters.montage.run_montage}"

# --- Trace controls ---------------------------------------------------------
BCC_INCLUDE_NET="${BCC_INCLUDE_NET:-0}"
BCC_PERF_PAGES="${BCC_PERF_PAGES:-1024}"
COLLECT_LUSTRE_COUNTERS="${COLLECT_LUSTRE_COUNTERS:-0}"
LUSTRE_COUNTER_INTERVAL_SEC="${LUSTRE_COUNTER_INTERVAL_SEC:-1}"
MONTAGE_OFFLINE="${MONTAGE_OFFLINE:-1}"
RUN_WORKLOADS="${RUN_WORKLOADS:-}"

# Format: name|mosaic_size_degrees|repetition
WORKLOADS=(
  "montage_m17_0p10_r1|0.10|1"
  "montage_m17_0p10_r2|0.10|2"
  "montage_m17_0p10_r3|0.10|3"
  "montage_m17_0p25_r1|0.25|1"
  "montage_m17_0p25_r2|0.25|2"
  "montage_m17_0p25_r3|0.25|3"
  "montage_m17_0p50_r1|0.50|1"
  "montage_m17_0p50_r2|0.50|2"
  "montage_m17_0p50_r3|0.50|3"
  "montage_m17_1p00_r1|1.00|1"
  "montage_m17_1p00_r2|1.00|2"
  "montage_m17_1p00_r3|1.00|3"
  "montage_m17_2p00_r1|2.00|1"
  "montage_m17_2p00_r2|2.00|2"
  "montage_m17_2p00_r3|2.00|3"
)

